{
  "security": {
    "authorization": "rbac",
    "authentication": "jwt",
    "data_protection": {
      "data_masking": true,
      "field_encryption": [
        "email",
        "phone"
      ],
      "encryption_at_rest": true,
      "encryption_in_transit": true
    },
    "password_policy": {
      "min_length": 8,
      "expiration_days": 90,
      "require_numbers": true,
      "require_special": true,
      "require_uppercase": true
    },
    "input_validation": {
      "sanitization": true,
      "rate_limiting": "100 requests per minute per user",
      "file_upload_limits": "none",
      "sql_injection_protection": true
    },
    "session_management": {
      "refresh_token": true,
      "timeout_minutes": 30,
      "concurrent_sessions": 2
    }
  },
  "tech_stack": {
    "backend": {
      "database": "managed by Convex",
      "language": "typescript",
      "framework": "convex"
    },
    "frontend": {
      "styling": "tailwind",
      "testing": "jest, playwright",
      "language": "typescript",
      "framework": "nextjs",
      "build_tool": "vite",
      "ui_library": "shadcn",
      "state_management": "convex_real_time_queries"
    },
    "deployment": {
      "cdn": "none",
      "monitoring": "none",
      "backend_hosting": "convex",
      "database_hosting": "convex",
      "frontend_hosting": "vercel"
    }
  },
  "architecture": {
    "pattern": "microservices",
    "real_time": "websockets",
    "api_design": "convex_api",
    "file_uploads": "none",
    "background_jobs": "none",
    "folder_structure": "feature_based"
  },
  "design_customization": {
    "color_palette": {
      "text": "#000000",
      "accent": null,
      "primary": "#3b82f6",
      "secondary": null,
      "background": "#ffffff"
    },
    "design_references": {
      "design_systems": [],
      "specific_notes": "Focus on clean, intuitive layouts with sufficient whitespace for clarity.",
      "inspiration_sites": [
        "https://www.education.com/",
        "https://www.edutopia.org/"
      ],
      "component_libraries": [
        "https://radix-ui.com/"
      ],
      "uploaded_screenshots": null
    },
    "visual_description": "The overall look is modern and user-friendly, focused on accessibility and responsiveness to enhance educator interaction.",
    "ui_library_customizations": {
      "theme_variant": "light",
      "layout_preferences": "A simple, grid-based layout that adapts well to various screen sizes.",
      "component_overrides": "Custom styles for buttons and forms based on design tokens."
    }
  }
}