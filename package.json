{
  "name": "edcoach-ai",
  "version": "0.1.0",
  "description": "AI-powered instructional coaching and feedback platform for K-12 schools",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx testing/scripts/run-tests.ts",
    "test:once": "vitest run",
    "test:watch": "tsx testing/scripts/run-tests.ts --watch",
    "test:debug": "tsx testing/scripts/run-tests.ts --debug",
    "test:coverage": "tsx testing/scripts/run-tests.ts --coverage",
    "test:ui": "vitest --ui",
    "test:unit": "tsx testing/scripts/run-tests.ts --category unit",
    "test:integration": "tsx testing/scripts/run-tests.ts --category integration",
    "test:e2e": "tsx testing/scripts/run-tests.ts --category e2e",
    "test:performance": "tsx testing/scripts/run-tests.ts --category performance",
    "test:verbose": "tsx testing/scripts/run-tests.ts --verbose",
    "test:ci": "tsx testing/scripts/ci-tests.ts --category all --verbose",
    "test:local": "tsx testing/scripts/run-tests.ts --category all --watch",
    "test:quick": "tsx testing/scripts/run-tests.ts --category unit --no-coverage",
    "test:full": "tsx testing/scripts/run-tests.ts --category all --coverage --verbose --debug",
    "test:help": "tsx testing/scripts/run-tests.ts --help"
  },
  "dependencies": {
    "@clerk/backend": "^2.25.0",
    "@clerk/clerk-react": "^5.57.1",
    "@clerk/nextjs": "^6.35.6",
    "@clerk/themes": "^2.4.41",
    "@convex-dev/resend": "0.1.2-beta.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "card": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.30.0",
    "convex-helpers": "^0.1.106",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.18.2",
    "isomorphic-dompurify": "^2.33.0",
    "lucide-react": "^0.484.0",
    "motion": "^12.23.25",
    "next": "15.5.9",
    "next-themes": "^0.4.6",
    "openai": "^4.104.0",
    "react": "^19.2.1",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.68.0",
    "recharts": "^2.15.4",
    "resend": "^4.8.0",
    "sonner": "^2.0.7",
    "svix": "^1.82.0",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "convex-test": "^0.0.38",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@playwright/test": "1.55.1",
      "playwright": "1.55.1",
      "playwright-core": "1.55.1"
    }
  }
}
